# 예시 파일에는 실제 키를 넣지 않습니다. 실행 환경 변수로 등록하세요.
TMAP_APP_KEY=
COMEBACK_SECRET_KEY=
COMEBACK_DATA_DIR=instance
# Render: 실제 Disk를 /var/data에 연결한 뒤 COMEBACK_DATA_DIR=/var/data/comeback-on 사용.
# 다른 위치에 디스크를 연결한 경우에만 아래 경로도 변경합니다.
COMEBACK_PERSISTENT_MOUNT=/var/data
COMEBACK_COOKIE_SECURE=0
# 실제 보행 도로 GeoJSON을 준비한 경우에만 지정합니다.
ROUTING_GRAPH_FILE=

# Supabase PostgreSQL Session pooler URI. Render Environment에서만 실제 값을 등록합니다.
DATABASE_URL=
